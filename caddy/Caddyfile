# Bloque global — token Cloudflare con Zone:DNS:Edit sobre garatortiz.xyz
# Certificados Let's Encrypt vía DNS challenge (válidos en LAN; no requiere
# exponer el lab a Internet). Registros A → IP LAN del servidor, proxy OFF.
{
    acme_dns cloudflare {$CLOUDFLARE_API_TOKEN}
}

(noindex) {
    header X-Robots-Tag "noindex, nofollow"
}

# --- INFRAESTRUCTURA EN DOCKER ---

home.garatortiz.xyz {
    reverse_proxy homepage:3000
}

status.garatortiz.xyz {
    reverse_proxy uptime-kuma:3001
}

n8n.garatortiz.xyz {
    @cors_preflight method OPTIONS
    handle @cors_preflight {
        header Access-Control-Allow-Origin {$N8N_CORS_ORIGIN}
        header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        header Access-Control-Allow-Headers "Accept, Authorization, Content-Type, Origin, User-Agent, X-Requested-With"
        header Access-Control-Max-Age "3600"
        respond "" 204
    }

    handle {
        header Access-Control-Allow-Origin {$N8N_CORS_ORIGIN}
        header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        header Access-Control-Allow-Headers "Accept, Authorization, Content-Type, Origin, User-Agent, X-Requested-With"

        reverse_proxy n8n:5678
    }
}

docker.garatortiz.xyz {
    reverse_proxy portainer:9443 {
        transport http {
            tls
            tls_insecure_skip_verify
        }
    }
}

git.garatortiz.xyz {
    reverse_proxy forgejo:3000 {
        flush_interval -1

        transport http {
            read_timeout 0s
            write_timeout 0s
            response_header_timeout 0s
        }
    }
}

releases.garatortiz.xyz {
    basic_auth {
        {$RELEASE_DASHBOARD_USER} {$RELEASE_DASHBOARD_PASSWORD_HASH}
    }
    reverse_proxy release-dashboard:3000
}

ai.garatortiz.xyz {
    reverse_proxy langfuse-web:3000
}

mail.garatortiz.xyz {
    reverse_proxy mailpit:8025
}

s3.garatortiz.xyz {
    reverse_proxy minio:9000
}

minio.garatortiz.xyz {
    reverse_proxy minio:9001
}

sonar.garatortiz.xyz {
    reverse_proxy sonarqube:9000
}

cal.garatortiz.xyz {
    reverse_proxy dcal-web:3000
}

cal-api.garatortiz.xyz {
    reverse_proxy dcal-api:4000
}

