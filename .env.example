# ==========================================
# KIME INFRA - PLANTILLA DE ENTORNO
# ==========================================
# INSTRUCCIONES: Copia este archivo como '.env' (cp .env.example .env)
# y reemplaza los valores de ejemplo por tus propias contraseñas seguras.

# ------------------------------------------
# Host (ajustar según tu servidor)
# ------------------------------------------
HOST_IP=192.168.100.111
FORGEJO_GIT_STORAGE=/mnt/storage/forgejo-data
DOCKER_SOCKET=/var/run/docker.sock
# GID del grupo docker en el host: getent group docker | cut -d: -f3
DOCKER_GID=999
N8N_CORS_ORIGIN=https://n8n.garatortiz.xyz

# ------------------------------------------
# Caddy / Cloudflare (ACME DNS para *.garatortiz.xyz)
# Registros A → IP LAN del servidor, proxy OFF. El challenge es solo DNS.
# ------------------------------------------
# Crear token en Cloudflare con permiso Zone:DNS:Edit sobre tu dominio.
# Si un token estuvo expuesto en git, revócalo y genera uno nuevo.
CLOUDFLARE_API_TOKEN=reemplaza_por_tu_token_de_cloudflare

# ------------------------------------------
# PostgreSQL (Base de Datos Central)
# ------------------------------------------
POSTGRES_PASSWORD=tu_password_segura_aqui

# Roles por aplicación (menor privilegio, cada uno dueño solo de su schema).
# Generar con: openssl rand -hex 24
# En instalaciones nuevas los crea init-scripts/02-app-roles.sh; en instancias
# existentes correr una vez: bash scripts/migrate-db-roles.sh
N8N_DB_PASSWORD=reemplaza_por_un_password_hex_generado
LANGFUSE_DB_PASSWORD=reemplaza_por_un_password_hex_generado
SONAR_DB_PASSWORD=reemplaza_por_un_password_hex_generado
# Base propia `plane` y schema `n8n_apps_schema` (init nuevo o scripts/migrate-db-roles.sh)
PLANE_DB_PASSWORD=reemplaza_por_un_password_hex_generado
N8N_APPS_DB_PASSWORD=reemplaza_por_un_password_hex_generado

# ------------------------------------------
# Redis (broker/cache de Langfuse)
# Generar con: openssl rand -hex 24
# ------------------------------------------
REDIS_PASSWORD=reemplaza_por_un_password_hex_generado

# ------------------------------------------
# MinIO (Almacenamiento S3 Local)
# API S3: https://s3.garatortiz.xyz | Consola web: https://minio.garatortiz.xyz
# ------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=tu_password_segura_para_minio_aqui

# Usuario S3 dedicado de Langfuse, limitado al bucket 'langfuse'.
# Lo crea scripts/init-minio-buckets.sh (make init-minio).
LANGFUSE_S3_ACCESS_KEY=langfuse-app
LANGFUSE_S3_SECRET_KEY=reemplaza_por_un_password_hex_generado

# ------------------------------------------
# Forgejo (Git Auto-alojado)
# ------------------------------------------
# IMPORTANTE: Genera nuevos secretos seguros ejecutando en tu terminal:
# openssl rand -base64 32
FORGEJO_LFS_JWT_SECRET=reemplaza_por_un_token_base64_generado
FORGEJO_INTERNAL_TOKEN=reemplaza_por_un_token_base64_generado
FORGEJO_JWT_SECRET=reemplaza_por_un_token_base64_generado
FORGEJO_RUNNER_TOKEN=reemplaza_por_el_token_de_registro_del_runner

# ------------------------------------------
# SMTP (Notificaciones de correo)
# ------------------------------------------
FORGEJO_SMTP_PASSWD="tu_app_password_de_google_o_smtp"

# ------------------------------------------
# Langfuse (Observabilidad de IA)
# ------------------------------------------
# La URL base debe coincidir con el dominio configurado en Caddy
NEXTAUTH_URL=https://ai.garatortiz.xyz
# Genera estas claves de seguridad ejecutando: openssl rand -base64 32
NEXTAUTH_SECRET=reemplaza_por_un_token_base64_generado
SALT=reemplaza_por_un_token_base64_generado

# Bucket S3 en MinIO (crear con scripts/init-minio-buckets.sh)
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse

# ------------------------------------------
# Release Dashboard (ops internas, detrás de Caddy basic_auth)
# https://releases.garatortiz.xyz — NO va a Vercel
# ------------------------------------------
# Path al monorepo kanto en el host (build context del Dockerfile).
# Relativo al fragmento release-dashboard/docker-compose.yml (no a la raíz de docker-infra):
#   ../../repositories/kanto → ~/projects/repositories/kanto
# También podés usar un path absoluto.
KANTO_REPO_PATH=../../repositories/kanto
# Mismos nombres que .forgejo/workflows/release.yml
GITEA_URL=http://forgejo:3000
BOT_TOKEN=reemplaza_por_bot_token_de_forgejo
GITEA_TOKEN=reemplaza_por_bot_token_de_forgejo
GITHUB_REPOSITORY=garatortiz/kanto
VERCEL_TOKEN=reemplaza_por_vercel_token
VERCEL_ORG_ID=reemplaza_por_vercel_org_id
# Basic Auth en Caddy (la app Next no ve passwords)
RELEASE_DASHBOARD_USER=matias
# Generar: docker run --rm caddy:2.10.2 caddy hash-password --plaintext 'tu-password'
# En valores .env de Compose, escapá cada $ del hash bcrypt como $$
# Hash de ejemplo para password "changeme" (rotá esto):
RELEASE_DASHBOARD_PASSWORD_HASH=$$2a$$14$$6itj7JBTSwnj58h.DhBaSut1F46EBiyQe7dX64rj8LW6NVQpLgKMC

# ------------------------------------------
# Homepage (widgets). Los valores llegan como HOMEPAGE_VAR_*
# ------------------------------------------
HOMEPAGE_PORTAINER_KEY=reemplaza_por_api_key_de_portainer
HOMEPAGE_UPTIMEKUMA_SLUG=reemplaza_por_el_slug_del_status_page
HOMEPAGE_FORGEJO_TOKEN=reemplaza_por_token_de_forgejo

# ------------------------------------------
# Plane (https://plane.garatortiz.xyz)
# Postgres compartido (rol plane_app / base plane). Redis, RabbitMQ y MinIO
# propios del módulo. openssl rand -hex 32 para las claves.
# ------------------------------------------
PLANE_APP_RELEASE=v1.4.2
PLANE_SECRET_KEY=reemplaza_por_un_token_hex_generado
PLANE_LIVE_SERVER_SECRET_KEY=reemplaza_por_un_token_hex_generado
PLANE_RABBITMQ_PASSWORD=reemplaza_por_un_password_hex_generado
PLANE_AWS_ACCESS_KEY_ID=plane-minio-user
PLANE_AWS_SECRET_ACCESS_KEY=reemplaza_por_un_password_hex_generado

# ------------------------------------------
# Watchtower (solo contenedores con label enable=true)
# Dejá MONITOR_ONLY=true hasta revisar el primer informe.
# URL shoutrrr vacía = sin notificación.
# ------------------------------------------
WATCHTOWER_MONITOR_ONLY=true
WATCHTOWER_NOTIFICATION_URL=
